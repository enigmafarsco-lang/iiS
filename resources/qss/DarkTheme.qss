QFrame#line_2
{
    background:aqua;
}
QLineEdit {
        background:#d3d3d3;
        color:#04101C;
        font:bold;
        border-radius: 3px;
	/*border-width: 1px; border-radius: 4px;
	border-style: solid;
	border-color: qlineargradient(spread:pad, x1:0.5, y1:1, x2:0.5, y2:0, stop:0 rgba(0, 113, 255, 255), stop:1 rgba(91, 171, 252, 255));*/
}
QLabel {
        color:#d3d3d3;
        border:none;
        font-family: Segoe UI;
        font: bold;
       /* font-size: 11px;*/
}
