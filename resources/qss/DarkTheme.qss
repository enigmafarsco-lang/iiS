QComboBox#comboBoxJM_Auto_OurSoftware
{
    min-height:30px;
    font:bold;
    font-family: Segoe UI;
    font-size: 14px;
}
QComboBox:editable {
        background: #d3d3d3;
        color: #04101C;
       /* selection-color:rgb(81,72,65);
        selection-background-color: red;*/
}
QComboBox QAbstractItemView {
        color:#04101C;
        background: #d3d3d3;
        selection-color:#d3d3d3;
        selection-background-color: #16a596;
}
QComboBox:!editable:on, QComboBox::drop-down:editable:on {
        /*color:#1e1d23;*/
        background: #ffffff;
}
QToolBox {
	color: #a9b7c6;
        background-color:#000000;
}
QToolBox::tab {
	color: #a9b7c6;
        background-color:#000000;
}
QToolBox::tab:selected {
	color: #FFFFFF;
        background-color:#000000;
}
QToolBar
{
    background-color:transparent;
}
/*QToolBar::separator
{
    background-color: aqua;
    width: 1px;
    height:0 px;

}*/
QToolButton
{
    background-color: transparent;
    border: none;
}

QTableView
{
    border-bottom-left-radius: 13px;
    border-bottom-right-radius: 13px;
    background-color:#16a596;
    color:#04101C;
    border: 2px solid aqua;
    margin: 1px;
    padding: 2px;
    text-align: center;
    font-family: Segoe UI;
    font-size: 14px;
    font:bold;
    alternate-background-color:white;
    selection-background-color: #04101C;
}
QTableCornerButton::section
{
    background-color: #04101C;
    border: 2px solid equa;
}

QTableView::item:focus
{
    selection-background-color: qlineargradient(x1: 0, y1: 0, x2: 0.5, y2: 0.5,
    stop: 0 #16a596, stop: 1 white);
    selection-color:#04101C;
}
 /*QTableView::item
{
   border: 1px solid #04101C;
   font-size: 14px;
   font:bold;
}*/
QTableView:verticalScrollBar
{
    width: 30px;
    color:black;
}


QHeaderView::section
{
    spacing: 10px;
    background-color:#04101C;
    border: 2px solid aqua;
    margin: 1px;
    padding: 2px;
    font-family: Segoe UI;
    font-size: 14px;
    font:bold;
    color: #d3d3d3;
}

QTableWidget
{
    background-color:#04101C;
    gridline-color: white;
    gridline-width:4px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    border:1px solid white;
   /* border: 1px solid white;*/
    color:aqua;
}
QTableWidget::item
{
   /* background-color:white;
    border: 0.5px solid white;
    color:aqua;*/
}

QTableCornerButton::section#tableWidgetForScalling
{
    background-color: #04101C;
    border: none;
}

QGroupBox
{
    border: 1px solid aqua;
    margin-top: 27px;
    font-size: 13px;
    font:bold;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
    background-color: #04101C;
}

QGroupBox:title
{
    subcontrol-origin: margin;
    subcontrol-position: top center;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    padding: 5px 50px;
    background-color:#04101C;
    /*rgb(253,253,253);*/
    /*#36EEE0;*/
    color:#d3d3d3;
}
QGroupBox:title#m_settingGroupBox_1,:title#m_spectrumAndTable_1,:title#m_ppiAndJamming,:title#groupBox_Spectrum_1,:title#m_settingGroupBox_2,:title#groupBox_PDWOut_1,:title#groupBox_Spectrums_2,:title#groupBox_TargetAndJamming_1,:title#pdwOutput_GroupBox_2,:title#groupBox_SpectrumAndTarget_1,:title#m_ScaledPageAndPPI,:title#groupBox_RBW125_1,:title#groupBox_RBW780_1,:title#groupBox_RBW125_2,:title#groupBox_RBW780_2
{
    subcontrol-origin: margin;
    subcontrol-position: top center;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    padding: 5px 65px;
    background-color:rgb(253,253,253);
    /*#36EEE0;*/
    color:#04101C;
}
QGroupBox:title#groupBoxChannelParam
{
    subcontrol-origin: margin;
    subcontrol-position: top center;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    padding: 5px 65px;
    background-color:rgb(253,253,253);
    /*#36EEE0;*/
    color:#04101C;
    font-size: 13px;
    font:bold;
}
QGroupBox#groupBox_SlcChannel,#groupBox_Channel,#groupBoxBufferParam,#groupBox_MInNumOfPuls,#groupBoxModulationRecognition,#groupBoxTargetClustring,#groupBoxTargetIntegration,#groupBoxTargetLoss,#groupBoxSLCMissPulse,#groupBoxOfDBSCANParam,#groupBoxNoiseReduParam,#groupBoxChannelParam,#groupBox_ReceiverError,#groupBoxOfSLC_ClusteringParams,#groupBoxOnlineClustering
{
    font-size: 15px;
}
QGroupBox:title#groupBox_SlcChannel,:title#groupBox_Channel
{
    subcontrol-origin: margin;
    subcontrol-position: top center;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    padding: 5px 60px;
    background-color:#6DE0CD;
    /*#36EEE0;*/
    color:#04101C;
   /* font:11 px;*/
}
QGroupBox:title#groupBoxBufferParam,:title#groupBox_MInNumOfPuls,:title#groupBoxModulationRecognition,:title#groupBoxTargetClustring,:title#groupBoxTargetIntegration,:title#groupBoxTargetLoss,:title#groupBoxSLCMissPulse,:title#groupBoxOfDBSCANParam,:title#groupBoxNoiseReduParam,:title#groupBox_ReceiverError,:title#groupBoxOfSLC_ClusteringParams,:title#groupBoxOnlineClustering
{
    subcontrol-origin: margin;
    subcontrol-position: top center;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    padding: 5px 250px;
    background-color:#6DE0CD;
    /*#36EEE0;*/
    color:#04101C;
   /* font:11 px;*/
}
