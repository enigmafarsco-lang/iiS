void ReceiverMain::on_btnSetBandSelect_clicked()
{

    double fs1 = ui->spnMin->value(); //?
    double fs2 = ui->spnMax->value();//?

    bool instop{};
    double fc{centerFrq}; //frq
    double fs1ch{};
    double fs2ch{};
    double inchn{};
    int p{};
    double tmp{};
    //    fc TODO= receive frq value
    //    if (ui->radBandSelect->setEnabled())
    //    {
    //        instop =true;
    //    }
    //    else {
    //        instop =false;
    //    }

    double bw=122.88*2;
    double chbw=bw/32;
    double fs2n=(fs2-fc);
    double fs1n=(fs1-fc);

    if(fs1>fc)
    {
        fs1ch= floor(fs1n/chbw);
    }

    else
    {
        fs1ch= ceil(fs1n/chbw);
    }


    if(fs1ch<0)
    {
        fs1ch = fs1ch +32;
    }

    if(fs2>fc)
    {
        fs2ch= floor(fs2n/chbw);
    }
    else
    {
        fs2ch= ceil(fs2n/chbw);
    }


    if(fs2ch<0){
        fs2ch = fs2ch +32;
    }


    if(((fs1ch <16) && (fs2ch >15)) || ((fs2ch <16) && (fs1ch >15)))
    {
        instop = !instop;
    }

    if(instop)
    {
        inchn=4294967295;
        p=-1;
    }
    else
    {
        inchn=0;
        p=1;
    }

    if(fs1ch>fs2ch && fs1ch!=0)
    {
        tmp=fs2ch;
        fs2ch=fs1ch;
        fs1ch=tmp;
    }


    if(fs2ch>15 && fs1ch==0)
    {
        tmp=fs2ch;
        fs2ch=31;
        fs1ch=tmp;
        inchn=inchn+p* pow(2,0) ;
    }

    for (int i=int(fs1ch) ; i<= fs2ch ; i++)
    {
        inchn=inchn+p* pow(2,i) ;
    }

    emit inChannel(inchn); // pass it to the InChannel in adrv unit
}


void ReceiverMain::frqValueChenged(QString val)
{

    int frqVal= frqSpn->value();
    if(frqVal > 2000 && frqVal <7000 )
    {

        if( !timeDomainPlot->isCaptureOn || !frqDomainPlot->isCaptureOn)
        {
            QMessageBox msgBox;
            msgBox.setText("Please turn on capture buttons.");
            msgBox.exec();
            return;
        }

        frqSpn->clearFocus();
        timeDomainPlot->btn_capt->click();
        frqDomainPlot->btnfftcapt->click();

        QTimer::singleShot(400, [&]{timeDomainPlot->btn_capt->click();});
        QTimer::singleShot(800, [&]{frqDomainPlot->btnfftcapt->click();});
    }
}

void ReceiverMain::settingMinMaxBand()
{
    centerFrq = frqSpn->value();
    ui->spnMax->setValue(centerFrq+250);
    ui->spnMin->setValue(centerFrq -250);
}

