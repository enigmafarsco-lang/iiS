double ReceiverMain::maximumFinder(double * newVal,double * max)
{

    if(*newVal > *max)
    {
        max = newVal;
    }
    return *max;
}


double ReceiverMain::minimumFinder(double * newVal,double * min)
{
    if(*newVal < *min)
    {
        min = newVal;
    }

    return *min;
}




